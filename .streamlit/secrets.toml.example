# Copy relevant lines into Streamlit Community Cloud's
# "Settings → Secrets" box for your deployed app (do not commit a real
# secrets.toml — it's gitignored).
#
# Set this to run the public preview on synthetic data, so it always works
# even if FINRA/EDGAR are slow or unreachable from Streamlit Cloud's IPs.
# Omit it (or set to "0") for live data.
WHALETRADING_DEMO = "1"

# Optional, free: syncs your pinned/added/reordered watchlist across
# devices and browsers via a private GitHub Gist, instead of it resetting
# on every page reload. See README "Sync your watchlist across devices"
# for the 4 setup steps. Omit both to keep today's session-only behavior.
GITHUB_GIST_TOKEN = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GITHUB_GIST_ID = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
